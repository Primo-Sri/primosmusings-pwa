rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guest tags — anyone can read (main app displays them),
    // only signed-in admin can write
    match /episodeTags/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Episode cache — written by the main app (no auth), read by admin
    match /cache/{doc} {
      allow read:  if true;
      allow write: if true;
    }

    // Transcripts — public read (search), auth-only write (admin upload)
    match /transcripts/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Play stats — incremented by the main app on every play (no auth),
    // read by admin for analytics
    match /playStats/{doc} {
      allow read:  if true;
      allow write: if true;
    }

    // Daily Bite newsletter — anyone can read (the /daily/ page and the
    // Home card show it), only the signed-in admin can publish or remove.
    // dailyBites = date + headline; dailyBiteImages = the image itself.
    match /dailyBites/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
    match /dailyBiteImages/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Newsletters (Daily Bite, NFL Recap, NFL Preview) — one slot each, named
    // daily / nflRecap / nflPreview. Anyone can read, only the admin can publish.
    // newsletters = date + headline + Substack link; newsletterImages = the image.
    match /newsletters/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
    match /newsletterImages/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Polls — anyone can read. Only the signed-in admin creates, edits or removes them.
    // A listener can only add ONE vote at a time: nothing but `counts` may change,
    // exactly one existing answer goes up by exactly 1, and only while voting is open.
    function isOneVote() {
      let before = resource.data.counts;
      let after = request.resource.data.counts;
      let changed = after.diff(before).affectedKeys();
      // Answers are stored as o0..o3 (admin allows at most 4).
      // The same answers must exist before and after (no answers added or removed).
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts'])
        && after.keys().hasOnly(before.keys())
        && before.keys().hasOnly(after.keys())
        && changed.size() == 1
        && ((changed.hasAny(['o0']) && after.o0 == before.o0 + 1)
         || (changed.hasAny(['o1']) && after.o1 == before.o1 + 1)
         || (changed.hasAny(['o2']) && after.o2 == before.o2 + 1)
         || (changed.hasAny(['o3']) && after.o3 == before.o3 + 1))
        && request.time < resource.data.closesAt;
    }
    match /polls/{pollId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || isOneVote();
    }

  }
}
